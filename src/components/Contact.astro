---
import { FaGithub, FaLinkedin, FaEnvelope, FaWhatsapp } from 'react-icons/fa';
---

<section id="contacto" class="py-20 bg-zinc-50 dark:bg-zinc-900/50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-4xl font-bold text-zinc-900 dark:text-zinc-50 mb-12 text-center">
      Contacto
    </h2>
    <div class="bg-white dark:bg-zinc-800 rounded-lg p-8 shadow-sm">
      <p class="text-center text-zinc-600 dark:text-zinc-300 mb-8">
        ¿Tienes algún proyecto en mente o buscas colaboración? No dudes en contactarme.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        <a
          href="mailto:atmoralesc@gmail.com"
          class="flex items-center gap-4 p-4 bg-zinc-50 dark:bg-zinc-700/50 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-700 transition-colors"
        >
          <FaEnvelope className="text-2xl text-blue-600 dark:text-blue-400" />
          <div>
            <p class="text-sm text-zinc-500 dark:text-zinc-400">Email</p>
            <p class="text-zinc-900 dark:text-zinc-50 font-medium">
              atmoralesc@gmail.com
            </p>
          </div>
        </a>
        <!-- El número no va escrito en el HTML: lo arma el script de abajo para
             que no lo recojan los programas que buscan teléfonos en sitios web. -->
        <a
          data-whatsapp="5,6,9,6,4,6,1,0,8,8,0"
          href="#contacto"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-4 bg-zinc-50 dark:bg-zinc-700/50 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-700 transition-colors"
        >
          <FaWhatsapp className="text-2xl text-blue-600 dark:text-blue-400" />
          <div>
            <p class="text-sm text-zinc-500 dark:text-zinc-400">WhatsApp</p>
            <p data-whatsapp-number class="text-zinc-900 dark:text-zinc-50 font-medium">
              Disponible con JavaScript activado
            </p>
          </div>
        </a>
      </div>
      <div class="mt-8 pt-6 border-t border-zinc-200 dark:border-zinc-700">
        <p class="text-center text-sm text-zinc-500 dark:text-zinc-400 mb-4">
          También puedes encontrarme en
        </p>
        <div class="flex justify-center gap-6">
          <a
            href="https://github.com/sauk1346"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-4 py-2 bg-zinc-100 dark:bg-zinc-700/50 rounded-lg text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
          >
            <FaGithub className="text-xl" />
            <span class="font-medium">GitHub</span>
          </a>
          <a
            href="https://www.linkedin.com/in/atmoralesc/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-4 py-2 bg-zinc-100 dark:bg-zinc-700/50 rounded-lg text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
          >
            <FaLinkedin className="text-xl" />
            <span class="font-medium">LinkedIn</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Los dígitos van separados por comas en data-whatsapp y se unen en el navegador
  // (si se escribieran en el script, el build los juntaría en el número completo).
  const link = document.querySelector<HTMLAnchorElement>('[data-whatsapp]');
  const label = document.querySelector<HTMLElement>('[data-whatsapp-number]');
  const digits = link?.dataset.whatsapp?.split(',').join('') ?? '';
  if (link && label && digits.length === 11) {
    link.href = `https://wa.me/${digits}`;
    label.textContent = `+${digits.slice(0, 2)} ${digits.slice(2, 3)} ${digits.slice(3, 7)} ${digits.slice(7)}`;
  }
</script>
